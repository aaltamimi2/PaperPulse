# PaperPulse Configuration
# Copy this file to .env and fill in your values

# Application
APP_NAME=PaperPulse
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
SECRET_KEY=your-secret-key-change-in-production

# Database (PostgreSQL with pgvector)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paperpulse
DB_USER=paperpulse
DB_PASSWORD=your-db-password

# Google Gemini API
GEMINI_API_KEY=your-gemini-api-key
GEMINI_EMBEDDING_MODEL=text-embedding-004
GEMINI_CHAT_MODEL=gemini-2.0-flash
GEMINI_EMBEDDING_DIMENSIONS=768

# Email Configuration
EMAIL_PROVIDER=console  # Use 'smtp' for production
EMAIL_FROM_ADDRESS=digest@paperpulse.local
EMAIL_FROM_NAME=PaperPulse
EMAIL_SMTP_HOST=smtp.gmail.com
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=your-email@gmail.com
EMAIL_SMTP_PASSWORD=your-app-password
EMAIL_SMTP_USE_TLS=true

# RSS Collector
RSS_USER_AGENT=PaperPulse/1.0 (Academic Paper Aggregator)
RSS_FETCH_TIMEOUT_SECONDS=30
RSS_MAX_CONCURRENT_FEEDS=5
RSS_RETRY_ATTEMPTS=3
RSS_RETRY_DELAY_SECONDS=2.0
